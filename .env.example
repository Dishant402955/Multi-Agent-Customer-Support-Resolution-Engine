# ============================================================
# Ports (3000/4000/4500 avoided — change here if any collide)
# web runs on 3100 (set in apps/web/package.json + apps/web/.env.local)
# ============================================================
AGENT_PORT=5000
API_PORT=4100

# ============================================================
# Internal wiring
# ============================================================
AGENT_URL=http://localhost:5000

# Frontend → API. Next.js reads this from apps/web/.env.local (not this file).
NEXT_PUBLIC_API_URL=http://localhost:4100

# ============================================================
# LLM provider (specialist agents are LLM-backed — a key is REQUIRED)
# ============================================================
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...your-key...
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible gateway/proxy (must end with /v1)
# OPENAI_BASE_URL=https://your-host/openai/v1

# Routing gates used by each agent's internal classifier
DOMAIN_THRESHOLD=0.3
CONFIDENCE_THRESHOLD=0.6

# Durable per-agent audit log (set AUDIT_LOG=off to disable file logging)
AUDIT_LOG=on
AUDIT_LOG_FILE=logs/audit.jsonl
